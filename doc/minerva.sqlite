drop table if exists hosts;
drop table if exists ports;

create table hosts(id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, ipv4 text, mac text, vendor text, hostname text);
create table ports(
	host_id int references host(rowid),
	protocol text,
	port_num int,
	state text,
	reason text,
	service text,
	product text,
	version text,
	extrainfo text
);

