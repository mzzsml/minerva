drop table if exists hosts;
drop table if exists ports;
drop table if exists hostnames;

create table hosts(id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, ipv4 text, mac text, vendor text, status text, reason text, scanned_at text);
create table ports(
	host_id int references hosts(rowid),
	protocol text,
	port_num int,
	state text,
	reason text,
	service text,
	product text,
	version text,
	extrainfo text
	);
create table hostnames(
	host_id int references hosts(rowid),
	hostname text,
	type text
	);
